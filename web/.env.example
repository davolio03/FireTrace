# Copy to `.env` to run the web against the local real data bundle and API.
# The Vite dev/preview server proxies /api to the FastAPI app and /data to the
# static server hosting data/processed/web (see README.md), so this origin is
# the only one the browser talks to.

# Disable the mock service worker (MSW) and use the API.
VITE_USE_MOCKS=false

# Bundle files served by the /data proxy.
VITE_DATA_BASE_URL=/data/

# Leave empty to use the /api proxy. Set a full URL only when the API is on
# another origin that allows this web origin (CORS).
VITE_API_BASE_URL=
