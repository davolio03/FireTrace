{
  "name": "firetrace-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "generate:types": "openapi-typescript ../contracts/openapi.yaml -o src/generated/api.ts && prettier --write src/generated/api.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
