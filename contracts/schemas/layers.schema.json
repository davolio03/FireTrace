{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firetrace.local/contracts/layers.schema.json",
  "title": "LayerManifest",
  "description": "Manifest of map layers (web/layers.json). Each raster layer is ONE RGBA PNG already warped to EPSG:3857, displayed with a MapLibre 'image' source using `coordinates`. Transparent pixels = invalid/nodata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "data_status", "layers"],
  "properties": {
    "contract_version": { "const": "1.1.0" },
    "data_status": { "enum": ["mock", "real"] },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" }, "minItems": 1 }
  },
  "$defs": {
    "lonlat": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "group", "default_visible", "default_opacity", "legend"],
      "properties": {
        "id": {
          "enum": [
            "sar_t1_hh", "sar_t2_hh", "sar_t1_hv", "sar_t2_hv",
            "change_hh", "change_hv", "change_index",
            "highlight_mask", "valid_mask", "perimeter", "review_zones"
          ]
        },
        "title": { "type": "string", "description": "UI label in English, e.g. 'Observed radar changes'." },
        "kind": { "enum": ["raster", "vector"] },
        "group": { "enum": ["sar", "observed_change", "highlighted_change", "reference", "quality"], "description": "Observation / interpretation / contrast separation." },
        "epoch": { "enum": ["t1", "t2"] },
        "polarization": { "enum": ["HH", "HV"] },
        "url": { "type": "string", "description": "Relative to the data base URL, e.g. layers/change_index.png or perimeter.geojson." },
        "coordinates": {
          "description": "Raster only: [top-left, top-right, bottom-right, bottom-left] as [lon, lat].",
          "type": "array",
          "items": { "$ref": "#/$defs/lonlat" },
          "minItems": 4,
          "maxItems": 4
        },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "default_visible": { "type": "boolean" },
        "default_opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "p1": { "type": "boolean", "description": "true for exploratory P1 layers (F05)." },
        "legend": { "$ref": "#/$defs/legend" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "raster" } } }, "then": { "required": ["url", "coordinates", "width_px", "height_px"] } },
        { "if": { "properties": { "kind": { "const": "vector" } } }, "then": { "required": ["url"] } }
      ]
    },
    "legend": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "units", "domain", "stops"],
          "properties": {
            "type": { "const": "continuous" },
            "units": { "type": "string", "description": "e.g. 'dB', 'dB difference', 'index (unitless)'" },
            "domain": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "color"],
                "properties": { "value": { "type": "number" }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } }
              }
            },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "categorical" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "label", "color"],
                "properties": { "value": { "type": ["number", "string"] }, "label": { "type": "string" }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } }
              }
            },
            "note": { "type": "string" }
          }
        }
      ]
    }
  }
}
