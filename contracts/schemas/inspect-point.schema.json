{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firetrace.local/contracts/inspect-point.schema.json",
  "title": "InspectPoint",
  "description": "Evidence Inspector response for one pixel: GET /api/inspect/point?lon=&lat=. All values are computed from the products; nothing is generated by an LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "data_status", "query", "pixel", "valid", "hh_db", "hv_db", "change_index", "highlighted", "perimeter_relation", "method_id", "caveats"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "data_status": { "enum": ["mock", "real"] },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lon", "lat"],
      "properties": { "lon": { "type": "number" }, "lat": { "type": "number" } }
    },
    "pixel": {
      "description": "Pixel actually sampled on the 10 m analysis grid (EPSG:32610). null when the query is outside the AOI.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["row", "col", "x", "y", "crs", "center_lon", "center_lat"],
          "properties": {
            "row": { "type": "integer", "minimum": 0 },
            "col": { "type": "integer", "minimum": 0 },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "crs": { "type": "string" },
            "center_lon": { "type": "number" },
            "center_lat": { "type": "number" }
          }
        }
      ]
    },
    "valid": { "type": "boolean", "description": "false if outside the AOI or masked in any of the 4 layers; then all values are null." },
    "hh_db": { "$ref": "#/$defs/polValues" },
    "hv_db": { "$ref": "#/$defs/polValues" },
    "change_index": { "type": ["number", "null"] },
    "change_index_percentile": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Percentile of this value among all valid pixels in the AOI." },
    "highlighted": { "type": ["boolean", "null"], "description": "P1: whether the pixel exceeds the exploratory threshold. null when the mask is disabled." },
    "perimeter_relation": { "enum": ["inside", "outside", "unknown"] },
    "method_id": { "type": "string" },
    "caveats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "triggered", "reason"],
        "properties": {
          "id": { "enum": ["steep_slope", "radar_shadow_layover", "soil_moisture_change", "vegetation_structure", "near_perimeter_edge", "low_backscatter", "other_disturbance"] },
          "label": { "type": "string" },
          "triggered": { "type": "boolean", "description": "true if a deterministic rule fired for this pixel; false = generic, always-applicable caution." },
          "reason": { "type": "string", "description": "Rule and the value that triggered it, e.g. 'slope 34° > 30°'." }
        }
      }
    }
  },
  "$defs": {
    "polValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t1", "t2", "delta"],
      "description": "Backscatter in dB (10*log10 of GCOV power). delta = t2 - t1.",
      "properties": {
        "t1": { "type": ["number", "null"] },
        "t2": { "type": ["number", "null"] },
        "delta": { "type": ["number", "null"] }
      }
    }
  }
}
